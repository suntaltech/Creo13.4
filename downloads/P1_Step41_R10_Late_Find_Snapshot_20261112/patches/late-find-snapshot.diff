+// R10_INITIAL_BASELINES_BEGIN
+struct LateFindBaseline {
+    const char* command;
+    char sdk_action_name[32];
+    uiCmdCmdId action_add_id;
+    uiCmdCmdId find_id;
+    ProError find_status;
+    bool valid_pair;
+    volatile LONG ready; // 0 empty, 1 writing, 2 immutable/published.
+};
+LateFindBaseline late_find_baselines[3] = {
+    {"p1_readonly_body_face_count", "p1_readonly_fc", nullptr, nullptr, PRO_TK_NO_ERROR, false, 0},
+    {"p1_readonly_model_info", "p1_readonly_model_info", nullptr, nullptr, PRO_TK_NO_ERROR, false, 0},
+    {"p1_readonly_ping", "p1_readonly_ping", nullptr, nullptr, PRO_TK_NO_ERROR, false, 0}
+};
+volatile LONG late_find_state = 0; // 0 unclaimed, 1 started, 2 completed; never reset in this DLL load.
+
+void capture_initial_find(LateFindBaseline& baseline, uiCmdCmdId action_add_id,
+    uiCmdCmdId found, ProError status) noexcept
+{
+    // Publish the first initialization observation once; never compare freed pointees.
+    if (InterlockedCompareExchange(&baseline.ready, 1, 0) != 0) return;
+    baseline.find_status = status;
+    baseline.valid_pair = status == PRO_TK_NO_ERROR && found != nullptr && action_add_id != nullptr;
+    baseline.action_add_id = baseline.valid_pair ? action_add_id : nullptr;
+    baseline.find_id = baseline.valid_pair ? found : nullptr;
+    InterlockedExchange(&baseline.ready, 2);
+}
+// R10_INITIAL_BASELINES_END
