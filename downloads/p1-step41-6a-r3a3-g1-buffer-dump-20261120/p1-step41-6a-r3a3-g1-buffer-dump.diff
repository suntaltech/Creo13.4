+void smt6a_dump_message_buffer(const Smt6aContext& c, const char* role,
+    const char* key, const char* value, ProError status, const ProLine& buffer) noexcept
+{
+    PreserveLastError preserve;
+    const bool truncated = status == PRO_TK_MSG_TOO_LONG;
+    const bool readable = status == PRO_TK_NO_ERROR || truncated;
+    size_t units = 0;
+    if (readable) {
+        while (units < PRO_LINE_SIZE && buffer[units] != L'\0') ++units;
+    }
+    const bool terminated = readable && units < PRO_LINE_SIZE;
+    constexpr size_t json_capacity = (PRO_LINE_SIZE - 1) * 6 + 3;
+    char text_json[json_capacity] = {};
+    const bool text_ok = terminated && quote_message_utf16(buffer, units, text_json, sizeof(text_json));
+    bool placeholder = false;
+    if (terminated) {
+        for (size_t i = 0; i + 2 < units; ++i) {
+            if (buffer[i] == L'%' && buffer[i + 1] == L'0' && buffer[i + 2] == L's') {
+                placeholder = true;
+                break;
+            }
+        }
+    }
+
+    // Callers supply the already-validated UTF-8 name chunks or generated ASCII details.
+    char param_json[json_capacity] = {};
+    const char* param_kind = "null";
+    if (value) {
+        if (!quote_json_utf8(value, param_json, sizeof(param_json))) {
+            trace_failure("buffer_dump_format", ERROR_INSUFFICIENT_BUFFER);
+            return;
+        }
+        param_kind = "\"ascii\"";
+        for (auto p = reinterpret_cast<const unsigned char*>(value); *p; ++p) {
+            if (*p > 0x7f) { param_kind = "\"zh\""; break; }
+        }
+    }
+
+    char count[24] = "null";
+    if (readable) std::snprintf(count, sizeof(count), "%u", static_cast<unsigned>(units));
+    // Use the facts limit, leaving the existing trace envelope its capacity.
+    char facts[model_facts_capacity] = {};
+    const int n = std::snprintf(facts, sizeof(facts),
+        "{\"operation_id\":%llu,\"stage\":\"%s\",\"probe\":\"buffer_dump_v1\","
+        "\"role\":\"%s\",\"key\":\"%s\",\"param_kind\":%s,\"param_json\":%s,"
+        "\"pro_error\":%d,\"buffer_observed\":%s,\"wide_units\":%s,\"terminated\":%s,"
+        "\"sdk_reported_truncation\":%s,\"text_json_valid\":%s,\"text_json\":%s,"
+        "\"placeholder_remaining\":%s,\"buffer_match_expected\":null}",
+        static_cast<unsigned long long>(c.id), c.stage, role, key, param_kind,
+        value ? param_json : "null", static_cast<int>(status), readable ? "true" : "null",
+        count, readable ? (terminated ? "true" : "false") : "null",
+        truncated ? "true" : "false", readable ? (text_ok ? "true" : "false") : "null",
+        text_ok ? text_json : "null", terminated ? (placeholder ? "true" : "false") : "null");
+    if (n <= 0 || static_cast<size_t>(n) >= sizeof(facts)) {
+        trace_failure("buffer_dump_format", ERROR_INSUFFICIENT_BUFFER);
+        return;
+    }
+    trace_event("SMT_CONV_BUFFER_DUMP", facts);
+}
