+        double minimum=Math.min(Math.hypot(Math.hypot(ab[0],ab[1]),ab[2]),Math.min(Math.hypot(Math.hypot(ac[0],ac[1]),ac[2]),Math.hypot(Math.hypot(bc[0],bc[1]),bc[2])));
+        return new double[]{area,minimum};
+    }
