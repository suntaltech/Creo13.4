+        if(distinct.size()!=3)throw new IllegalArgumentException("BASELINE_INDICES_DUPLICATE");
+        for(int i:baseline)if(i<0||i>=points.size())throw new IllegalArgumentException("BASELINE_INDEX_OUT_OF_RANGE");
