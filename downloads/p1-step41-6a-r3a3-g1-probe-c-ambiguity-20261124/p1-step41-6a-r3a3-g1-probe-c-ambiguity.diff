+void smt6a_trace_selection(const Smt6aContext& c, int limit, int count, ProError status) noexcept
+{
+    PreserveLastError preserve;
+    char returned_count[24] = "null";
+    if (status == PRO_TK_NO_ERROR)
+        std::snprintf(returned_count, sizeof(returned_count), "%d", count);
+    char facts[256] = {};
+    const int n = std::snprintf(facts, sizeof(facts),
+        "{\"operation_id\":%llu,\"stage\":\"select\",\"filter\":\"surface\","
+        "\"max_count\":%d,\"count\":%s,\"pro_error\":%d}",
+        static_cast<unsigned long long>(c.id), limit, returned_count, static_cast<int>(status));
+    smt6a_checked_event("SMT_CONV_SELECTION", facts, n, sizeof(facts));
+}
+
+void smt6a_trace_ambiguous_items(const Smt6aContext& c, ProMdl model,
+    const ProSelection* borrowed, int count, int limit) noexcept
+{
+    if (!borrowed || count < 2) return;
+    PreserveLastError preserve;
+    for (int i = 0; i < count && i < limit; ++i) {
+        ProModelitem item = {};
+        char status[24] = "null", id[24] = "null", type[24] = "null";
+        bool exception = false;
+        const char* owner_matches = "null";
+        if (borrowed[i]) {
+            try {
+                // Query while the selection is borrowed; never copy or retain it.
+                const ProError code = ProSelectionModelitemGet(borrowed[i], &item);
+                std::snprintf(status, sizeof(status), "%d", static_cast<int>(code));
+                if (code == PRO_TK_NO_ERROR) {
+                    std::snprintf(id, sizeof(id), "%d", item.id);
+                    std::snprintf(type, sizeof(type), "%d", static_cast<int>(item.type));
+                    owner_matches = item.owner == model ? "true" : "false";
+                }
+            } catch (...) {
+                exception = true;
+            }
+        }
+        char facts[320] = {};
+        const int n = std::snprintf(facts, sizeof(facts),
+            "{\"operation_id\":%llu,\"stage\":\"select\",\"selection_index\":%d,"
+            "\"pro_error\":%s,\"item_id\":%s,\"item_type\":%s,\"owner_matches_model\":%s,\"exception\":%s}",
+            static_cast<unsigned long long>(c.id), i, status, id, type, owner_matches,
+            exception ? "true" : "false");
+        smt6a_checked_event("SMT_CONV_AMBIGUOUS_ITEM", facts, n, sizeof(facts));
+    }
+}
