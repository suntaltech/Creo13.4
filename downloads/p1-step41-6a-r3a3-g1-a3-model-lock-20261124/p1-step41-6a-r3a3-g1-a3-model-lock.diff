@@ -0,0 +1,115 @@
+// Lock ownership is local to one Create attempt. An existing lock is never taken over.
+class Smt6aSessionLock {
+public:
+    Smt6aSessionLock(Smt6aContext& context, ProMdl model) noexcept
+        : context_(context), model_(model) {}
+    Smt6aSessionLock(const Smt6aSessionLock&) = delete;
+    Smt6aSessionLock& operator=(const Smt6aSessionLock&) = delete;
+
+    bool acquire()
+    {
+        auto& facts = context_.lock;
+        if (!observe(facts.initial_get, [&] {
+                return ProMdlLockGet(model_, &facts.initially_locked);
+            })) {
+            context_.result = "A3_INITIAL_LOCK_QUERY_FAILED";
+            return false;
+        }
+        if (facts.initially_locked != PRO_B_FALSE) {
+            context_.result = "A3_INITIAL_LOCK_NOT_CLEAR";
+            return false;
+        }
+
+        observe(facts.modifiable_before, [&] {
+            return ProMdlIsModifiable(model_, PRO_B_FALSE, &facts.can_modify_before);
+        });
+        // Verify restoration even if the Set call fails after changing the state.
+        facts.restoration_required = true;
+        const bool set_ok = observe(facts.set, [&] {
+            return ProMdlLockSet(model_, PRO_B_TRUE);
+        });
+        const bool get_ok = observe(facts.locked_get, [&] {
+            return ProMdlLockGet(model_, &facts.locked);
+        });
+        if (!set_ok || !get_ok || facts.locked != PRO_B_TRUE) {
+            context_.result = "A3_LOCK_NOT_CONFIRMED";
+            return false;
+        }
+
+        observe(facts.modifiable_after, [&] {
+            return ProMdlIsModifiable(model_, PRO_B_FALSE, &facts.can_modify_after);
+        });
+        return true;
+    }
+
+    ~Smt6aSessionLock() noexcept
+    {
+        auto& facts = context_.lock;
+        if (!facts.restoration_required) return;
+        restore_call(facts.unset, [&] { return ProMdlLockSet(model_, PRO_B_FALSE); });
+        restore_call(facts.final_get, [&] { return ProMdlLockGet(model_, &facts.finally_locked); });
+        if (facts.finally_locked != PRO_B_FALSE) context_.cleanup_failed = true;
+    }
+
+private:
+    template<class Call>
+    bool observe(Smt6aLockCall& evidence, Call call)
+    {
+        evidence.status = smt6a_sdk(context_, evidence.api, call);
+        evidence.returned = true;
+        return evidence.succeeded();
+    }
+
+    template<class Call>
+    void restore_call(Smt6aLockCall& evidence, Call call) noexcept
+    {
+        try {
+            if (!observe(evidence, call)) context_.cleanup_failed = true;
+        } catch (...) {
+            context_.cleanup_failed = true;
+        }
+    }
+
+    Smt6aContext& context_;
+    ProMdl model_;
+};
+
+const char* smt6a_lock_boolean(const Smt6aLockCall& query, ProBoolean value) noexcept
+{
+    if (query.succeeded()) {
+        if (value == PRO_B_TRUE) return "true";
+        if (value == PRO_B_FALSE) return "false";
+    }
+    return "null";
+}
+
+void smt6a_a3_lock_trace(const Smt6aContext& c) noexcept
+{
+    const auto& lock = c.lock;
+    const Smt6aLockCall* calls[] = {
+        &lock.initial_get, &lock.modifiable_before, &lock.set, &lock.locked_get,
+        &lock.modifiable_after, &lock.unset, &lock.final_get,
+    };
+    char statuses[7][24] = {};
+    for (size_t i = 0; i < sizeof(calls) / sizeof(calls[0]); ++i) {
+        if (calls[i]->returned)
+            std::snprintf(statuses[i], sizeof(statuses[i]), "%d", static_cast<int>(calls[i]->status));
+        else
+            std::memcpy(statuses[i], "null", 5);
+    }
+
+    char facts[768] = {};
+    const int n = std::snprintf(facts, sizeof(facts),
+        "{\"operation_id\":%llu,\"initial_lock_get_status\":%s,\"initially_locked\":%s,"
+        "\"modifiable_before_status\":%s,\"can_modify_before\":%s,\"lock_set_status\":%s,"
+        "\"lock_get_status\":%s,\"is_locked\":%s,\"modifiable_after_status\":%s,\"can_modify_after\":%s,"
+        "\"restoration_required\":%s,\"unlock_set_status\":%s,\"unlock_get_status\":%s,\"is_locked_after_unlock\":%s}",
+        static_cast<unsigned long long>(c.id),
+        statuses[0], smt6a_lock_boolean(lock.initial_get, lock.initially_locked),
+        statuses[1], smt6a_lock_boolean(lock.modifiable_before, lock.can_modify_before),
+        statuses[2], statuses[3], smt6a_lock_boolean(lock.locked_get, lock.locked),
+        statuses[4], smt6a_lock_boolean(lock.modifiable_after, lock.can_modify_after),
+        lock.restoration_required ? "true" : "false", statuses[5], statuses[6],
+        smt6a_lock_boolean(lock.final_get, lock.finally_locked));
+    smt6a_checked_event("SMT_CONV_A3_LOCK", facts, n, sizeof(facts));
+}
