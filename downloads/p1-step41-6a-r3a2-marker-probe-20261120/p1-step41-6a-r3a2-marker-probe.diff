+struct R3Marker {
+    const R3MessageVariant* variant = nullptr;
+    const wchar_t* token = nullptr;
+    const char* language_dir = nullptr;
+
+    bool found() const noexcept { return variant != nullptr; }
+    bool same_resource(const R3Marker& other) const noexcept
+    {
+        return found() && variant == other.variant && token == other.token;
+    }
+    std::string path_json() const
+    {
+        return found() ? std::string("\"text/") + language_dir + "/" + variant->filename + "\"" : "null";
+    }
+};
+
+std::string r3_message_utf16(const wchar_t* value)
+{
+    if (!value) return "null";
+    const size_t units = std::wcslen(value);
+    if (units >= PRO_LINE_SIZE) return "null";
+    if (units == 0) return "\"\"";
+    char utf8[PRO_LINE_SIZE * 3 + 1] = {}, quoted[483] = {};
+    if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, value, static_cast<int>(units),
+            utf8, sizeof(utf8) - 1, nullptr, nullptr) <= 0 ||
+        !quote_json_utf8(utf8, quoted, sizeof(quoted))) return "null";
+    return quoted;
+}
+
+struct R3MessageBuffer {
+    ProLine text = {};
+    R3Status status;
+
+    bool readable() const noexcept
+    {
+        return status.ok() || (status.returned && status.code == PRO_TK_MSG_TOO_LONG);
+    }
+    size_t units() const noexcept
+    {
+        size_t size = 0;
+        if (readable()) while (size < PRO_LINE_SIZE && text[size]) ++size;
+        return size;
+    }
+    bool terminated() const noexcept { return readable() && units() < PRO_LINE_SIZE; }
+    std::string json() const { return terminated() ? r3_message_utf16(text) : "null"; }
+};
+
+R3Marker r3_find_marker(const R3MessageBuffer& response, bool prefix) noexcept
+{
+    if (!response.status.ok() || !response.terminated()) return {};
+    for (const auto& variant : r3_variants) {
+        const wchar_t* tokens[] = {variant.zh_token, variant.ascii_token};
+        for (unsigned i = 0; i < 2; ++i) {
+            const size_t count = std::wcslen(tokens[i]);
+            if (response.units() < count || std::wmemcmp(response.text, tokens[i], count) != 0) continue;
+            if (response.text[count] == (prefix ? L'|' : L'\0')) {
+                return R3Marker{&variant, tokens[i], i == 0 ? "chinese_cn" : "usascii"};
+            }
+        }
+    }
+    return {};
+}
+
+bool r3_lookup_message(R3Run& run, ProFileName& file, const char* key_name,
+    const char* role, R3MessageBuffer& response, char* parameter = nullptr)
+{
+    ProCharLine key = {};
+    if (!r3_message_key(key, key_name)) return false;
+    r3_call(run, "ProMessageToBuffer", role, response.status, [&] {
+        return parameter ? ProMessageToBuffer(response.text, file, key, parameter) :
+            ProMessageToBuffer(response.text, file, key);
+    });
+    return true;
+}
+
+bool r3_display_message(R3Run& run, ProFileName& file, const char* key_name,
+    const char* role, R3Status& status, char* parameter)
+{
+    ProCharLine key = {};
+    if (!r3_message_key(key, key_name)) return false;
+    r3_call(run, "ProMessageDisplay", role, status, [&] {
+        return parameter ? ProMessageDisplay(file, key, parameter) : ProMessageDisplay(file, key);
+    });
+    return true;
+}
