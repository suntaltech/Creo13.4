+function Split-P1PathValue([AllowNull()][string]$Value) {
+    if($null -eq $Value){return $null}
+    $text=$Value.Trim();$quote=[char]0
+    for($i=0;$i -lt $text.Length;$i++) {
+        $c=$text[$i]
+        if($quote -ne [char]0){if($c -eq $quote){$quote=[char]0};continue}
+        if(($c -eq [char]34 -or $c -eq [char]39) -and ($i -eq 0 -or [char]::IsWhiteSpace($text[$i-1]))){$quote=$c;continue}
+        if(($c -eq [char]33 -or $c -eq [char]35) -and ($i -eq 0 -or [char]::IsWhiteSpace($text[$i-1]))){return $text.Substring(0,$i).TrimEnd()}
+    }
+    if($quote -ne [char]0){return $null}
+    return $text
+}
