+void smt6a_api_gate(Smt6aContext& c, const char* event, const char* api,
+    int element_id, const ProError* returned, bool exception) noexcept
+{
+    PreserveLastError preserve;
+    char code[24] = "null";
+    if (returned) std::snprintf(code, sizeof(code), "%d", static_cast<int>(*returned));
+    char facts[384] = {};
+    const int n = std::snprintf(facts, sizeof(facts),
+        "{\"operation_id\":%llu,\"stage\":\"%s\",\"api\":\"%s\","
+        "\"element_id\":%d,\"pro_error\":%s,\"exception\":%s}",
+        static_cast<unsigned long long>(c.id), c.stage, api, element_id, code,
+        exception ? "true" : "false");
+    smt6a_checked_event(event, facts, n, sizeof(facts));
+}
+
+template<class Call>
+ProError smt6a_sdk(Smt6aContext& c, const char* api, Call call, int element_id = -1)
+{
+    smt6a_api_gate(c, "SMT_CONV_API_START", api, element_id, nullptr, false);
+    try {
+        const ProError status = call();
+        smt6a_api_gate(c, "SMT_CONV_API_DONE", api, element_id, &status, false);
+        return status;
+    } catch (...) {
+        smt6a_api_gate(c, "SMT_CONV_API_DONE", api, element_id, nullptr, true);
+        throw;
+    }
+}
+
+template<class Call>
+void smt6a_cleanup(Smt6aContext& c, const char* api, Call call) noexcept
+{
+    try {
+        if (smt6a_sdk(c, api, call) != PRO_TK_NO_ERROR) c.cleanup_failed = true;
+    } catch (...) {
+        c.cleanup_failed = true;
+    }
+}
