+void smt6a_error_list(Smt6aContext& c, const ProErrorlist& errors) noexcept
+{
+    char facts[384] = {};
+    int n = std::snprintf(facts, sizeof(facts),
+        "{\"operation_id\":%llu,\"error_number\":%d,\"list_present\":%s}",
+        static_cast<unsigned long long>(c.id), errors.error_number, errors.error_list ? "true" : "false");
+    smt6a_checked_event("SMT_CONV_ERROR_LIST", facts, n, sizeof(facts));
+    if (!errors.error_list) return;
+    for (int i = 0; i < errors.error_number; ++i) {
+        const ProItemerror& item = errors.error_list[i];
+        n = std::snprintf(facts, sizeof(facts),
+            "{\"operation_id\":%llu,\"index\":%d,\"element_id\":%d,\"item_type\":%d,\"pro_error\":%d}",
+            static_cast<unsigned long long>(c.id), i, item.err_item_id,
+            static_cast<int>(item.err_item_type), static_cast<int>(item.error));
+        smt6a_checked_event("SMT_CONV_ELEMENT_ERROR", facts, n, sizeof(facts));
+    }
+}
