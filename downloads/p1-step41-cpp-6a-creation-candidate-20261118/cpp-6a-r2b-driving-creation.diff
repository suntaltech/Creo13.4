+bool smt6a_create(Smt6aContext& c, ProMdl model, ProSolidBody& body,
+    ProSelection face, ProFeature& feature)
+{
+    Smt6aPreparedTree tree(c);
+    c.stage = "wrap";
+    if (!smt6a_wrap_selections(tree, model, body)) {
+        smt6a_reject_command(c, "WRAP_SOLID_FAILED", "P1_SMT_CONV_WRAP_FAILED");
+        return false;
+    }
+    c.stage = "tree";
+    if (!smt6a_prepare_tree(tree, face, c.thickness_model)) {
+        smt6a_reject_command(c, "TREE_CREATE_FAILED", "P1_SMT_CONV_TREE_FAILED");
+        return false;
+    }
+    c.tree_ready = true;
+    char facts[160] = {};
+    const int n = std::snprintf(facts, sizeof(facts),
+        "{\"operation_id\":%llu,\"root_ready\":true,\"child_count\":6,\"create_called\":false}",
+        static_cast<unsigned long long>(c.id));
+    smt6a_checked_event("SMT_CONV_TREE_READY", facts, n, sizeof(facts));
+
+    c.stage = "create";
+    ProErrorlist errors = {};
+    c.create_status = smt6a_sdk(c, "ProFeatureWithoptionsCreate", [&] {
+        c.create_called = true;
+        return ProFeatureWithoptionsCreate(tree.model, tree.root, tree.options,
+            PRO_REGEN_NO_FLAGS, &feature, &errors);
+    });
+    c.create_valid = true;
+    smt6a_error_list(c, errors);
+    if (c.create_status == PRO_TK_CANT_MODIFY) {
+        smt6a_reject_command(c, "MODEL_READ_ONLY", "P1_SMT_CONV_READ_ONLY");
+        return false;
+    }
+    if (c.create_status != PRO_TK_NO_ERROR) {
+        smt6a_reject_command(c, "CREATE_FEATURE_FAILED", "P1_SMT_CONV_CREATE_FAILED");
+        return false;
+    }
+    return true;
+}
+
+bool smt6a_readback(Smt6aContext& c, ProSolid solid, const ProSolidBody& original,
+    ProFeature& feature, ProName& name)
+{
+    c.stage = "feature_identity";
+    if (feature.owner != original.owner || feature.id < 0) {
+        smt6a_reject_command(c, "FEATURE_READBACK_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    c.feature_id = feature.id;
+    c.stage = "regenerate";
+    c.regen_status = smt6a_sdk(c, "ProSolidRegenerate", [&] {
+        c.regen_called = true;
+        return ProSolidRegenerate(solid, PRO_REGEN_NO_FLAGS);
+    });
+    c.regen_valid = true;
+    if (c.regen_status != PRO_TK_NO_ERROR) {
+        smt6a_reject_command(c, "REGEN_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    c.stage = "postcheck";
+    ProSolidBody body = {};
+    ProBoolean sheetmetal = PRO_B_FALSE;
+    if (smt6a_sdk(c, "ProSolidDefaultBodyGet(post)", [&] {
+            return ProSolidDefaultBodyGet(solid, &body);
+        }) != PRO_TK_NO_ERROR) {
+        smt6a_reject_command(c, "STATUS_READBACK_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    if (body.id != original.id || body.owner != original.owner) {
+        smt6a_reject_command(c, "TARGET_BODY_CHANGED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    if (smt6a_sdk(c, "ProSolidBodyIsSheetmetal(post)", [&] {
+            return ProSolidBodyIsSheetmetal(&body, &sheetmetal);
+        }) != PRO_TK_NO_ERROR) {
+        smt6a_reject_command(c, "STATUS_READBACK_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    c.sheetmetal = sheetmetal == PRO_B_TRUE ? "true" : "false";
+    if (sheetmetal != PRO_B_TRUE) {
+        smt6a_reject_command(c, "STATUS_NOT_SHEETMETAL", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+
+    if (feature.owner != original.owner || feature.id != c.feature_id) {
+        smt6a_reject_command(c, "FEATURE_READBACK_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    ProFeattype type = {};
+    if (smt6a_sdk(c, "ProFeatureTypeGet", [&] {
+            return ProFeatureTypeGet(&feature, &type);
+        }) != PRO_TK_NO_ERROR) {
+        smt6a_reject_command(c, "FEATURE_READBACK_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    c.feature_type = static_cast<int>(type);
+    c.feature_type_valid = true;
+    if (smt6a_sdk(c, "ProModelitemNameGet(feature)", [&] {
+            return ProModelitemNameGet(&feature, name);
+        }) != PRO_TK_NO_ERROR || !name[0] ||
+        !smt6a_quote_wide(name, c.feature_json, sizeof(c.feature_json))) {
+        std::memcpy(c.feature_json, "null", 5);
+        smt6a_reject_command(c, "FEATURE_READBACK_FAILED", "P1_SMT_CONV_POST_FAILED");
+        return false;
+    }
+    return true;
+}
