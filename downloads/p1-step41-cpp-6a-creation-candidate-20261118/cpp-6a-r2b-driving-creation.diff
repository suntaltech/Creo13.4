+template<size_t N>
+bool smt6a_show_name(Smt6aContext& c, const char* key, const wchar_t (&name)[N])
+{
+    if (smt6a_message(c, key) != PRO_TK_NO_ERROR) return false;
+    char utf8[N * 3 + 1] = {};
+    if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, name,
+            -1, utf8, static_cast<int>(sizeof(utf8)), nullptr, nullptr) <= 0) return false;
+    const size_t length = std::strlen(utf8);
+    for (size_t start = 0; start < length;) {
+        size_t end = start + 60 < length ? start + 60 : length;
+        while (end < length && (static_cast<unsigned char>(utf8[end]) & 0xc0) == 0x80) --end;
+        char line[61] = {};
+        std::memcpy(line, utf8 + start, end - start);
+        if (!smt6a_text(c, line)) return false;
+        start = end;
+    }
+    return true;
+}
