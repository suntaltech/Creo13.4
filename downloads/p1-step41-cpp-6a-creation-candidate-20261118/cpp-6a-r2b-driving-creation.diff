+bool smt6a_show_success(Smt6aContext& c, const ProMdlName& model_name, const ProName& feature_name)
+{
+    char thickness[64] = {}, detail[80] = {};
+    if (!smt6a_number(c.thickness_mm, thickness)) return false;
+    const int n = std::snprintf(detail, sizeof(detail), "driving; thickness=%s mm", thickness);
+    if (n <= 0 || static_cast<size_t>(n) >= sizeof(detail)) return false;
+    if (smt6a_message(c, "P1_SMT_CONV_SUCCESS") != PRO_TK_NO_ERROR ||
+        !smt6a_show_name(c, "P1_SMT_CONV_MODEL_NAME", model_name) || !smt6a_text(c, detail)) return false;
+    const int k = std::snprintf(detail, sizeof(detail), "feature_id=%d; IsSheetmetal=true; Save not called",
+        c.feature_id);
+    return k > 0 && static_cast<size_t>(k) < sizeof(detail) && smt6a_text(c, detail) &&
+        smt6a_show_name(c, "P1_SMT_CONV_FEATURE_NAME", feature_name);
+}
