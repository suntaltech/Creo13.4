+bool smt6a_text(Smt6aContext& c, char* value, bool preview_only = false)
+{
+    ProFileName file = L"p1_smt_conv.txt";
+    ProCharLine key = "P1_SMT_CONV_TEXT";
+    ProLine buffer = {};
+    const ProError preview = smt6a_sdk(c, "ProMessageToBuffer(conversion_text)", [&] {
+        return ProMessageToBuffer(buffer, file, key, value);
+    });
+    if (preview != PRO_TK_NO_ERROR) return false;
+    return preview_only || smt6a_sdk(c, "ProMessageDisplay(conversion_text)", [&] {
+        return ProMessageDisplay(file, key, value);
+    }) == PRO_TK_NO_ERROR;
+}
