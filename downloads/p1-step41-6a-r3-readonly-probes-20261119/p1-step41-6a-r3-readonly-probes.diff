+void r3_probe_units(R3Run& run)
+{
+    R3Model model;
+    ProUnitsystem system = {};
+    ProUnititem target = {}, mm = {};
+    ProName mm_name = L"mm";
+    ProUnitConversion conversion = {};
+    R3Status system_status, target_status, mm_status, conversion_status;
+    const bool context = model.read(run);
+    if (context) {
+        if (r3_call(run, "ProMdlPrincipalunitsystemGet", "units", system_status, [&] {
+                return ProMdlPrincipalunitsystemGet(model.handle, &system);
+            }) && r3_call(run, "ProUnitsystemUnitGet", "units", target_status, [&] {
+                return ProUnitsystemUnitGet(&system, PRO_UNITTYPE_LENGTH, &target);
+            }) && r3_call(run, "ProUnitInit", "mm", mm_status, [&] {
+                return ProUnitInit(model.handle, mm_name, &mm);
+            })) {
+            r3_call(run, "ProUnitConversionCalculate", "mm_to_current_model", conversion_status, [&] {
+                return ProUnitConversionCalculate(&mm, &target, &conversion);
+            });
+        }
+    }
+    const std::string from = mm_status.ok() ? r3_utf8_name(mm.name) : "null";
+    const std::string to = target_status.ok() ? r3_utf8_name(target.name) : "null";
+    const bool names_ok = from != "null" && to != "null";
+    const bool valid_conversion = conversion_status.ok();
+    const bool finite_scale = valid_conversion && std::isfinite(conversion.scale);
+    const bool zero_offset = valid_conversion && std::isfinite(conversion.offset) && conversion.offset == 0.0;
+    const double sample = 1.0 * conversion.scale + conversion.offset;
+    const bool sample_ok = finite_scale && conversion.scale > 0.0 && zero_offset &&
+        std::isfinite(sample) && sample > 0.0;
+    if (context) {
+        run.result = (target_status.ok() && to == "null") || (mm_status.ok() && from == "null") ?
+            "UNIT_NAME_INVALID" : !valid_conversion ? "UNIT_QUERY_FAILED" :
+            names_ok && sample_ok ? "UNITS_OBSERVED" : "UNIT_CONVERSION_INVALID";
+    }
+    run.terminal = model.facts() + ",\"system_pro_error\":" + system_status.json() +
+        ",\"unit_pro_error\":" + target_status.json() + ",\"mm_init_pro_error\":" + mm_status.json() +
+        ",\"convert_pro_error\":" + conversion_status.json() +
+        ",\"unit_from_name_json\":" + from + ",\"unit_to_name_json\":" + to +
+        ",\"direction\":\"mm_to_current_model\",\"scale\":" +
+            (valid_conversion ? r3_number(conversion.scale) : "null") +
+        ",\"offset\":" + (valid_conversion ? r3_number(conversion.offset) : "null") +
+        ",\"scale_finite\":" + (valid_conversion ? r3_bool(finite_scale) : "null") +
+        ",\"offset_zero\":" + (valid_conversion ? r3_bool(zero_offset) : "null") +
+        ",\"sample_mm\":1.0,\"sample_model_units\":" + (sample_ok ? r3_number(sample) : "null");
+}
