+struct R3BodyArray {
+    R3Run& context;
+    R3Status& free_status;
+    ProSolidBody* data = nullptr;
+
+    R3BodyArray(R3Run& run, R3Status& status) noexcept : context(run), free_status(status) {}
+    R3BodyArray(const R3BodyArray&) = delete;
+    R3BodyArray& operator=(const R3BodyArray&) = delete;
+    ~R3BodyArray() noexcept
+    {
+        if (!data) return;
+        ProArray owned = data;
+        try {
+            if (!r3_call(context, "ProArrayFree", "body_array", free_status, [&] {
+                    return ProArrayFree(&owned);
+                })) context.cleanup_failed = true;
+        } catch (...) {
+            context.cleanup_failed = true;
+        }
+    }
+};
+
+struct R3BodyFaces {
+    R3Run& run;
+    int index;
+    int body_id;
+    ProMdl owner;
+    bool is_default;
+    bool callback_failed = false, callback_exception = false;
+    R3Status surface_id_error, visit;
+    std::vector<int> ids;
+
+    R3BodyFaces(R3Run& r, int i, const ProSolidBody& body, const ProSolidBody& default_body) :
+        run(r), index(i), body_id(body.id), owner(body.owner),
+        is_default(body.id == default_body.id && body.owner == default_body.owner) {}
+};
+
+ProError r3_visit_surface(ProSurface surface, ProError incoming, ProAppData data) noexcept
+{
+    auto& body = *static_cast<R3BodyFaces*>(data);
+    if (incoming != PRO_TK_NO_ERROR) {
+        body.callback_failed = true;
+        return incoming;
+    }
+    try {
+        int id = -1;
+        R3Status status;
+        if (!r3_call(body.run, "ProSurfaceIdGet", "surface_visit", status, [&] {
+                return ProSurfaceIdGet(surface, &id);
+            })) {
+            body.callback_failed = true;
+            body.surface_id_error = status;
+            return status.code;
+        }
+        body.ids.push_back(id);
+        return PRO_TK_NO_ERROR;
+    } catch (...) {
+        body.callback_failed = true;
+        body.callback_exception = true;
+        return PRO_TK_GENERAL_ERROR;
+    }
+}
+
+void r3_log_body(const R3BodyFaces& body, ProMdl model)
+{
+    char owner[32] = {};
+    std::snprintf(owner, sizeof(owner), "0x%" PRIxPTR, reinterpret_cast<uintptr_t>(body.owner));
+    const bool complete = body.visit.ok() && !body.callback_failed;
+    const std::string prefix = ",\"body_index\":" + std::to_string(body.index) +
+        ",\"body_id\":" + std::to_string(body.body_id);
+    const std::string summary = prefix + ",\"owner\":\"" + owner + "\",\"owner_matches_model\":" +
+        r3_bool(body.owner == model) + ",\"is_default\":" + r3_bool(body.is_default) +
+        ",\"surface_count\":" + (complete ? std::to_string(body.ids.size()) : "null") +
+        ",\"observed_surface_count\":" + std::to_string(body.ids.size()) +
+        ",\"visit_pro_error\":" + body.visit.json() +
+        ",\"surface_id_error\":" + body.surface_id_error.json() +
+        ",\"callback_exception\":" + r3_bool(body.callback_exception) +
+        ",\"surface_ids_complete\":" + r3_bool(complete);
+    r3_trace(body.run, "R3_PROBE_BODY_VISIT", summary.c_str());
+    // A large model may exceed the JSONL line capacity. Keep all IDs in bounded chunks.
+    const size_t per_line = 32;
+    for (size_t begin = 0; begin < body.ids.size();) {
+        size_t end = begin;
+        std::string ids = "[";
+        for (; end < body.ids.size() && end - begin < per_line; ++end) {
+            if (end != begin) ids += ',';
+            ids += std::to_string(body.ids[end]);
+        }
+        const std::string chunk = prefix + ",\"first_surface_index\":" + std::to_string(begin) +
+            ",\"surface_ids_json\":" + ids + "]";
+        r3_trace(body.run, "R3_PROBE_BODY_SURFACE_IDS", chunk.c_str());
+        begin = end;
+    }
+}
