+struct R3Model {
+    ProMdl handle = nullptr;
+    ProMdlType type = PRO_MDL_UNUSED;
+    ProMdlName name = {};
+    R3Status current, type_status, name_status;
+    std::string name_json = "null";
+
+    bool read(R3Run& run)
+    {
+        if (!r3_call(run, "ProMdlCurrentGet", "model", current, [&] { return ProMdlCurrentGet(&handle); })
+            || !handle) { run.result = "MODEL_UNAVAILABLE"; return false; }
+        if (!r3_call(run, "ProMdlTypeGet", "model", type_status, [&] { return ProMdlTypeGet(handle, &type); })) {
+            run.result = "MODEL_TYPE_UNAVAILABLE"; return false;
+        }
+        if (type != PRO_MDL_PART) { run.result = "NOT_PART"; return false; }
+        if (!r3_call(run, "ProMdlMdlnameGet", "model", name_status, [&] { return ProMdlMdlnameGet(handle, name); })) {
+            run.result = "MODEL_NAME_UNAVAILABLE"; return false;
+        }
+        name_json = r3_utf8_name(name);
+        if (name_json == "null") { run.result = "MODEL_NAME_INVALID"; return false; }
+        return true;
+    }
+
+    std::string facts() const
+    {
+        return ",\"model_name\":" + name_json +
+            ",\"model_type\":" + (type_status.ok() ? std::to_string(static_cast<int>(type)) : "null") +
+            ",\"current_pro_error\":" + current.json() + ",\"type_pro_error\":" + type_status.json() +
+            ",\"name_pro_error\":" + name_status.json();
+    }
+};
