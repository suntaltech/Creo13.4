+template<size_t N>
+std::string r3_utf8_name(const wchar_t (&name)[N])
+{
+    size_t units = 0;
+    while (units < N && name[units]) ++units;
+    if (!units || units == N) return "null";
+    char utf8[N * 3 + 1] = {}, quoted[N * 6 + 3] = {};
+    if (WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, name, static_cast<int>(units),
+            utf8, static_cast<int>(sizeof(utf8) - 1), nullptr, nullptr) <= 0 ||
+        !quote_json_utf8(utf8, quoted, sizeof(quoted))) return "null";
+    return quoted;
+}
+
+std::string r3_number(double number)
+{
+    if (!std::isfinite(number)) return "null";
+    const _locale_t locale = _create_locale(LC_NUMERIC, "C");
+    if (!locale) return "null";
+    char buffer[64] = {};
+    const int written = _snprintf_l(buffer, sizeof(buffer), "%.17g", locale, number);
+    _free_locale(locale);
+    return written > 0 && static_cast<size_t>(written) < sizeof(buffer) ? buffer : "null";
+}
