+struct R3Definition {
+    const char* name;
+    const char* begin;
+    const char* finish;
+    unsigned ordinal;
+};
+constexpr R3Definition r3_definitions[] = {
+    {"message", "PROBE_MSG_BEGIN", "PROBE_MSG_RETURN", 1},
+    {"units", "PROBE_UNITS_BEGIN", "PROBE_UNITS_RETURN", 2},
+    {"bodies", "PROBE_BODIES_BEGIN", "PROBE_BODIES_RETURN", 3},
+};
+alignas(8) volatile LONG64 r3_sequence = 0;
+volatile LONG r3_busy = 0;
+
+struct R3Run {
+    const R3Definition& definition;
+    ULONGLONG id = static_cast<ULONGLONG>(InterlockedIncrement64(&r3_sequence));
+    const char* result = "INCOMPLETE";
+    bool cleanup_failed = false;
+    std::string terminal{};
+};
+
+const char* r3_bool(bool value) noexcept { return value ? "true" : "false"; }
+
+void r3_trace(const R3Run& run, const char* event, const char* details) noexcept
+{
+    char facts[model_facts_capacity] = {};
+    const int count = std::snprintf(facts, sizeof(facts),
+        "{\"probe\":\"%s\",\"probe_ordinal\":%u,\"operation_id\":%llu%s}",
+        run.definition.name, run.definition.ordinal, static_cast<unsigned long long>(run.id), details);
+    if (count > 0 && static_cast<size_t>(count) < sizeof(facts)) trace_event(event, facts);
+    else trace_failure("r3_probe_facts", ERROR_INSUFFICIENT_BUFFER);
+}
+
+struct R3Status {
+    bool returned = false;
+    ProError code = PRO_TK_NO_ERROR;
+    bool ok() const noexcept { return returned && code == PRO_TK_NO_ERROR; }
+    std::string json() const { return returned ? std::to_string(static_cast<int>(code)) : "null"; }
+};
+
+void r3_api(const R3Run& run, const char* event, const char* name,
+    const char* role, const R3Status& status, bool threw = false) noexcept
+{
+    char value[24] = "null", facts[300] = {};
+    if (status.returned) std::snprintf(value, sizeof(value), "%d", static_cast<int>(status.code));
+    const int count = std::snprintf(facts, sizeof(facts),
+        ",\"api\":\"%s\",\"role\":\"%s\",\"pro_error\":%s,\"exception\":%s",
+        name, role, value, r3_bool(threw));
+    if (count > 0 && static_cast<size_t>(count) < sizeof(facts)) r3_trace(run, event, facts);
+    else trace_failure("r3_probe_api_facts", ERROR_INSUFFICIENT_BUFFER);
+}
+
+template<class Function>
+bool r3_call(const R3Run& run, const char* name, const char* role, R3Status& status, Function fn)
+{
+    r3_api(run, "R3_PROBE_API_START", name, role, R3Status{});
+    try {
+        status.code = fn();
+        status.returned = true;
+        r3_api(run, "R3_PROBE_API_DONE", name, role, status);
+    } catch (...) {
+        r3_api(run, "R3_PROBE_API_DONE", name, role, R3Status{}, true);
+        throw;
+    }
+    return status.ok();
+}
