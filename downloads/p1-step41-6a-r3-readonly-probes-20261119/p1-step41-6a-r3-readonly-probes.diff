+bool r3_message_file(ProFileName& file, const wchar_t* value) noexcept
+{
+    const size_t count = std::wcslen(value);
+    if (count >= sizeof(file) / sizeof(file[0])) return false;
+    std::wmemcpy(file, value, count + 1);
+    return true;
+}
+
+bool r3_message_key(ProCharLine& key, const char* value) noexcept
+{
+    const size_t count = std::strlen(value);
+    if (count >= sizeof(key)) return false;
+    std::memcpy(key, value, count + 1);
+    return true;
+}
