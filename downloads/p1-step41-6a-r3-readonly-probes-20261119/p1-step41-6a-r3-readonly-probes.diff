+bool r3_pick_face(R3Run& run, ProMdl model, bool expected_default, int& face_id)
+{
+    const char* role = expected_default ? "default_body" : "other_body";
+    ProFileName file = L"p1_r3_readonly.txt";
+    ProCharLine prompt = {};
+    r3_message_key(prompt, expected_default ? "P1_R3_BODIES_PICK_DEFAULT" : "P1_R3_BODIES_PICK_OTHER");
+    R3Status display, selection, item_status, surface_status, surface_type;
+    if (!r3_call(run, "ProMessageDisplay", role, display, [&] { return ProMessageDisplay(file, prompt); })) {
+        run.result = "PROMPT_FAILED"; return false;
+    }
+    char filter[] = "surface";
+    ProSelection* borrowed = nullptr;
+    int count = 0;
+    if (!r3_call(run, "ProSelect", role, selection, [&] {
+            return ProSelect(filter, 1, nullptr, nullptr, nullptr, nullptr, &borrowed, &count);
+        })) {
+        run.result = selection.code == PRO_TK_USER_ABORT ? "CANCELLED" : "SELECTION_FAILED";
+        return false;
+    }
+    ProModelitem selected = {};
+    // The SDK's selection array is borrowed. Read the item before issuing another SDK query.
+    if (count != 1 || !borrowed || !borrowed[0] ||
+        !r3_call(run, "ProSelectionModelitemGet", role, item_status, [&] {
+            return ProSelectionModelitemGet(borrowed[0], &selected);
+        }) || selected.type != PRO_SURFACE || selected.owner != model) {
+        run.result = "SELECTED_FACE_INVALID"; return false;
+    }
+    ProSurface surface = nullptr;
+    ProSrftype type = PRO_SRF_NONE;
+    if (!r3_call(run, "ProSurfaceInit", role, surface_status, [&] {
+            return ProSurfaceInit(model, selected.id, &surface);
+        }) || !surface || !r3_call(run, "ProSurfaceTypeGet", role, surface_type, [&] {
+            return ProSurfaceTypeGet(surface, &type);
+        })) {
+        run.result = "SURFACE_QUERY_FAILED"; return false;
+    }
+    if (type != PRO_SRF_PLANE) { run.result = "SELECTED_FACE_NOT_PLANE"; return false; }
+    face_id = selected.id;
+    const std::string facts = std::string(",\"role\":\"") + role +
+        "\",\"selected_face_id\":" + std::to_string(face_id) +
+        ",\"surface_type\":" + std::to_string(static_cast<int>(type));
+    r3_trace(run, "R3_PROBE_FACE_SELECTED", facts.c_str());
+    return true;
+}
+
+bool r3_compare_face(R3Run& run, const std::vector<R3BodyFaces>& bodies, int face_id, bool expected_default)
+{
+    size_t matches = 0;
+    int matched_body = -1;
+    bool on_default = false;
+    for (const auto& body : bodies) {
+        for (int id : body.ids) {
+            if (id != face_id) continue;
+            ++matches;
+            matched_body = body.index;
+            on_default = body.is_default;
+        }
+    }
+    const bool expected = matches == 1 && on_default == expected_default;
+    const std::string facts =
+        ",\"expected_default\":" + std::string(r3_bool(expected_default)) +
+        ",\"selected_face_id\":" + std::to_string(face_id) +
+        ",\"matched_body_index\":" + (matches == 1 ? std::to_string(matched_body) : "null") +
+        ",\"match_count\":" + std::to_string(matches) +
+        ",\"belongs_to_default\":" + (matches == 1 ? r3_bool(on_default) : "null") +
+        ",\"result\":\"" + (expected ? "FACE_MEMBERSHIP_CONFIRMED" : "FACE_BODY_MISMATCH") + "\"";
+    r3_trace(run, "R3_PROBE_BODY_MATCH", facts.c_str());
+    return expected;
+}
+
+void r3_probe_bodies(R3Run& run)
+{
+    R3Model model;
+    R3Status default_status, collect, size, release, current_again, default_again;
+    ProSolidBody default_body = {};
+    int body_count = -1, defaults_matched = 0, first = -1, second = -1;
+    bool visits_ok = true, picked_first = false, picked_second = false, paired = false;
+    std::vector<R3BodyFaces> bodies;
+    auto observe = [&] {
+        if (!model.read(run)) return;
+        const ProSolid solid = reinterpret_cast<ProSolid>(model.handle);
+        if (!r3_call(run, "ProSolidDefaultBodyGet", "default_body", default_status, [&] {
+                return ProSolidDefaultBodyGet(solid, &default_body);
+            }) || default_body.owner != model.handle) {
+            run.result = "DEFAULT_BODY_UNAVAILABLE"; return;
+        }
+        {
+            R3BodyArray array(run, release);
+            if (!r3_call(run, "ProSolidBodiesCollect", "body_array", collect, [&] {
+                    return ProSolidBodiesCollect(solid, &array.data);
+                }) || !array.data || !r3_call(run, "ProArraySizeGet", "body_array", size, [&] {
+                    return ProArraySizeGet(array.data, &body_count);
+                }) || body_count < 0) {
+                run.result = "BODY_ARRAY_UNAVAILABLE"; return;
+            }
+            for (int i = 0; i < body_count; ++i) {
+                bodies.emplace_back(run, i, array.data[i], default_body);
+                auto& body = bodies.back();
+                if (body.is_default) ++defaults_matched;
+                r3_call(run, "ProSolidBodySurfaceVisit", "body_visit", body.visit, [&] {
+                    return ProSolidBodySurfaceVisit(&array.data[i], &r3_visit_surface, &body);
+                });
+                visits_ok = visits_ok && body.visit.ok() && !body.callback_failed &&
+                    body.owner == model.handle;
+                r3_log_body(body, model.handle);
+            }
+        }
+        if (run.cleanup_failed) { run.result = "CLEANUP_FAILED"; return; }
+        if (body_count < 2) { run.result = "MULTIBODY_FIXTURE_REQUIRED"; return; }
+        if (!visits_ok || defaults_matched != 1) { run.result = "FACE_BODY_MISMATCH"; return; }
+        picked_first = r3_pick_face(run, model.handle, true, first);
+        if (!picked_first) return;
+        picked_second = r3_pick_face(run, model.handle, false, second);
+        if (!picked_second) return;
+
+        ProMdl current = nullptr;
+        ProSolidBody body = {};
+        if (!r3_call(run, "ProMdlCurrentGet", "revalidate", current_again, [&] {
+                return ProMdlCurrentGet(&current);
+            }) || current != model.handle ||
+            !r3_call(run, "ProSolidDefaultBodyGet", "revalidate", default_again, [&] {
+                return ProSolidDefaultBodyGet(solid, &body);
+            }) || body.owner != default_body.owner || body.id != default_body.id) {
+            run.result = "STALE_CONTEXT"; return;
+        }
+        const bool first_matches = r3_compare_face(run, bodies, first, true);
+        const bool second_matches = r3_compare_face(run, bodies, second, false);
+        paired = first_matches && second_matches;
+        run.result = paired ? "FACE_MEMBERSHIP_CONFIRMED" : "FACE_BODY_MISMATCH";
+    };
+    observe();
+    char default_owner[32] = {};
+    std::snprintf(default_owner, sizeof(default_owner), "\"0x%" PRIxPTR "\"",
+        reinterpret_cast<uintptr_t>(default_body.owner));
+    run.terminal = model.facts() + ",\"default_body_id\":" +
+        (default_status.ok() ? std::to_string(default_body.id) : "null") +
+        ",\"default_body_owner\":" + (default_status.ok() ? default_owner : "null") +
+        ",\"default_body_owner_matches_model\":" +
+        (default_status.ok() ? r3_bool(default_body.owner == model.handle) : "null") +
+        ",\"body_get_pro_error\":" + default_status.json() +
+        ",\"body_count\":" + (size.ok() && body_count >= 0 ? std::to_string(body_count) : "null") +
+        ",\"collect_pro_error\":" + collect.json() + ",\"size_pro_error\":" + size.json() +
+        ",\"array_free_pro_error\":" + release.json() + ",\"free_pro_error\":" + release.json() +
+        ",\"default_face_id\":" + (picked_first ? std::to_string(first) : "null") +
+        ",\"other_face_id\":" + (picked_second ? std::to_string(second) : "null") +
+        ",\"revalidated_current_pro_error\":" + current_again.json() +
+        ",\"revalidated_body_pro_error\":" + default_again.json() +
+        ",\"membership_pair_confirmed\":" + r3_bool(paired);
+}
+
+AccessTrace r3_accesses[] = {
+    {"p1_r3_probe_msg", "p1_r3_probe_msg", 0, {}, {}},
+    {"p1_r3_probe_units", "p1_r3_probe_units", 0, {}, {}},
+    {"p1_r3_probe_bodies", "p1_r3_probe_bodies", 0, {}, {}}
+};
+
+template<size_t Index>
+uiCmdAccessState r3_access(uiCmdAccessMode mode)
+{
+    record_access_observation(r3_accesses[Index], mode, ACCESS_AVAILABLE);
+    return ACCESS_AVAILABLE;
+}
+
+template<size_t Index, void (*Probe)(R3Run&)>
+int r3_action(uiCmdCmdId, uiCmdValue*, void*) noexcept
+{
+    PreserveLastError preserve;
+    R3Run run{r3_definitions[Index]};
+    r3_trace(run, run.definition.begin, "");
+    if (InterlockedCompareExchange(&r3_busy, 1, 0) != 0) {
+        run.result = "COMMAND_BUSY";
+    } else {
+        struct BusyReset { ~BusyReset() { InterlockedExchange(&r3_busy, 0); } } reset;
+        try {
+            Probe(run);
+        } catch (...) {
+            run.result = "UNEXPECTED_EXCEPTION";
+        }
+        flush_one_access_trace(r3_accesses[Index], "r3_probe_return");
+    }
+    char details[model_facts_capacity] = {};
+    const int n = std::snprintf(details, sizeof(details),
+        ",\"result\":\"%s\",\"model_may_be_modified\":false,\"save_called\":false,\"cleanup_failed\":%s%s",
+        run.result, r3_bool(run.cleanup_failed), run.terminal.c_str());
+    if (n > 0 && static_cast<size_t>(n) < sizeof(details)) {
+        r3_trace(run, run.definition.finish, details);
+    } else {
+        r3_trace(run, run.definition.finish,
+            ",\"result\":\"TRACE_FACTS_TOO_LONG\",\"model_may_be_modified\":false,\"save_called\":false");
+    }
+    return 0;
+}
+
+template<size_t Index, void (*Probe)(R3Run&)>
+void r3_register(char* name, char* label, char* help, char* description) noexcept
+{
+    PreserveLastError preserve;
+    R3Run run{r3_definitions[Index]};
+    try {
+        ProFileName file = L"p1_r3_readonly.txt";
+        uiCmdCmdId id = nullptr;
+        R3Status add, designate;
+        if (!r3_call(run, "ProCmdActionAdd", "registration", add, [&] {
+                return ProCmdActionAdd(name, &r3_action<Index, Probe>, uiProeImmediate,
+                    &r3_access<Index>, PRO_B_TRUE, PRO_B_TRUE, &id);
+            }) || !id) {
+            r3_trace(run, "R3_PROBE_REGISTRATION_FAILED", ",\"phase\":\"add_or_identity\"");
+            return;
+        }
+        trace_registration_identity(name, id, name, label, help, description, file);
+        if (!r3_call(run, "ProCmdDesignate", "registration", designate, [&] {
+                return ProCmdDesignate(id, label, help, description, file);
+            })) {
+            r3_trace(run, "R3_PROBE_REGISTRATION_FAILED", ",\"phase\":\"designate\"");
+        }
+    } catch (...) {
+        r3_trace(run, "R3_PROBE_REGISTRATION_FAILED", ",\"phase\":\"exception\"");
+    }
+}
+
+void register_r3_readonly_probes() noexcept
+{
+    static char message[] = "p1_r3_probe_msg";
+    static char message_label[] = "P1_R3_MSG_LABEL", message_help[] = "P1_R3_MSG_HELP";
+    static char message_desc[] = "P1_R3_MSG_DESC";
+    static char units[] = "p1_r3_probe_units";
+    static char units_label[] = "P1_R3_UNITS_LABEL", units_help[] = "P1_R3_UNITS_HELP";
+    static char units_desc[] = "P1_R3_UNITS_DESC";
+    static char bodies[] = "p1_r3_probe_bodies";
+    static char bodies_label[] = "P1_R3_BODIES_LABEL", bodies_help[] = "P1_R3_BODIES_HELP";
+    static char bodies_desc[] = "P1_R3_BODIES_DESC";
+    r3_register<0, r3_probe_message>(message, message_label, message_help, message_desc);
+    r3_register<1, r3_probe_units>(units, units_label, units_help, units_desc);
+    r3_register<2, r3_probe_bodies>(bodies, bodies_label, bodies_help, bodies_desc);
+}
