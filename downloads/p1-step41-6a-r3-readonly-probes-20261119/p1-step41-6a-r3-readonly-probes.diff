+struct R3MessageVariant {
+    const wchar_t* file;
+    const char* name;
+    const char* encoding;
+};
+constexpr R3MessageVariant r3_variants[] = {
+    {L"p1_r3_a_utf8.txt", "current", "utf8_no_bom"},
+    {L"p1_r3_a_bom.txt", "bom", "utf8_bom"},
+    {L"p1_r3_a_cp936.txt", "cp936", "cp936_no_bom"},
+    {L"p1_r3_a_usascii.txt", "control", "usascii"},
+};
+// One sample per trigger leaves its status-bar text available for a screenshot.
+unsigned r3_message_sample = 0;
+bool r3_static_ok = false, r3_ascii_ok = false;
+
+void r3_probe_message(R3Run& run)
+{
+    const unsigned sample = r3_message_sample;
+    r3_message_sample = (sample + 1) % 10;
+    const bool control = sample == 0;
+    const unsigned step = control ? 0 : (sample - 1) % 3;
+    const auto& variant = r3_variants[control ? 3 : (sample - 1) / 3];
+    const char* role = step == 0 ? "static" : "dynamic";
+    const char* kind = step == 0 ? "none" : step == 1 ? "ascii" : "zh";
+    const char* message_key = step == 0 ? "P1_SMT_CONV_SELECT" : "P1_SMT_CONV_TEXT";
+    const wchar_t* expected = step == 0 ?
+        (control ? L"Select one planar surface belonging to the default body." :
+            L"\u8bf7\u9009\u62e9\u9ed8\u8ba4\u4f53\u4e0a\u7684\u4e00\u4e2a\u5e73\u9762\u66f2\u9762\u4f5c\u4e3a\u9a71\u52a8\u9762\u3002") :
+        step == 1 ? L"R3_ASCII" : L"\u4e2d\u6587";
+    const size_t expected_units = std::wcslen(expected);
+    char expected_json[483] = {};
+    if (!quote_message_utf16(expected, expected_units, expected_json, sizeof(expected_json))) {
+        run.result = "EXPECTED_TEXT_INVALID"; return;
+    }
+
+    if (step == 0) { r3_static_ok = false; r3_ascii_ok = false; }
+    const bool static_ok_before = r3_static_ok, ascii_ok_before = r3_ascii_ok;
+    ProFileName file = {};
+    ProCharLine key = {};
+    char value[64] = {};
+    ProLine translated = {};
+    R3Status buffer, display;
+    bool eligible = step == 0 || (static_ok_before && (step == 1 || ascii_ok_before));
+    if (eligible) {
+        if (!r3_message_file(file, variant.file) || !r3_message_key(key, message_key)) {
+            run.result = "RESOURCE_IDENTIFIER_INVALID"; return;
+        }
+        if (step != 0 && WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, expected, -1,
+                value, sizeof(value), nullptr, nullptr) <= 0) {
+            run.result = "PARAMETER_ENCODING_FAILED"; return;
+        }
+        r3_call(run, "ProMessageToBuffer", role, buffer, [&] {
+            return step == 0 ? ProMessageToBuffer(translated, file, key) :
+                ProMessageToBuffer(translated, file, key, value);
+        });
+        r3_call(run, "ProMessageDisplay", role, display, [&] {
+            return step == 0 ? ProMessageDisplay(file, key) : ProMessageDisplay(file, key, value);
+        });
+    }
+    const bool readable = buffer.ok() || (buffer.returned && buffer.code == PRO_TK_MSG_TOO_LONG);
+    size_t units = 0;
+    if (readable) while (units < PRO_LINE_SIZE && translated[units]) ++units;
+    const bool terminated = readable && units < PRO_LINE_SIZE;
+    char actual_json[483] = {};
+    const bool encoded = terminated && quote_message_utf16(translated, units, actual_json, sizeof(actual_json));
+    const bool match = buffer.ok() && terminated && units == expected_units &&
+        std::wmemcmp(translated, expected, expected_units) == 0;
+    if (step == 0 && !control) r3_static_ok = match;
+    if (step == 1) r3_ascii_ok = match;
+    run.result = !eligible ? "PREREQUISITE_UNVERIFIED" : !buffer.ok() ? "BUFFER_API_FAILED" :
+        !match ? "BUFFER_MISMATCH" : !display.ok() ? "DISPLAY_API_FAILED" : "BUFFER_MATCH";
+    const char* matched = readable ? r3_bool(match) : "null";
+    run.terminal =
+        ",\"sample\":" + std::to_string(sample + 1) + ",\"role\":\"" + role + "\"" +
+        ",\"key\":\"" + message_key + "\",\"variant\":\"" + variant.name + "\"" +
+        ",\"encoding_tag\":\"" + variant.encoding + "\",\"pro_error\":" + buffer.json() +
+        ",\"display_pro_error\":" + display.json() + ",\"wide_units\":" +
+            (readable ? std::to_string(units) : "null") + ",\"terminated\":" +
+            (readable ? r3_bool(terminated) : "null") +
+        ",\"text_json\":" + (encoded ? actual_json : "null") + ",\"expected_units_json\":" + expected_json +
+        ",\"unit_match\":" + matched + ",\"buffer_match\":" + matched + ",\"buffer_ok\":" + matched +
+        ",\"decode_layer\":\"" + (!eligible ? "untested" : !buffer.ok() ? "buffer_api_failed" :
+            match ? "buffer_matches" : step == 0 ? "resource_or_decode" : "parameter_or_substitution") + "\"" +
+        ",\"display_layer\":\"" + (display.ok() ? "requires_screenshot" :
+            display.returned ? "display_api_failed" : "not_attempted") +
+        "\",\"display_observed\":null,\"display_ok\":null" +
+        ",\"param_kind\":\"" + kind + "\",\"param_json\":" + (step ? expected_json : "null") +
+        ",\"param_roundtrip_ok\":" + (step ? matched : "null") +
+        ",\"control_file_sha256\":" + (control ?
+            "\"921ebd62f52ebf07759021f4e68b42ca6f0916c9f2e6e273af12468bc800aa4f\"" : "null") +
+        ",\"control_match\":" + (control ? matched : "null");
+}
